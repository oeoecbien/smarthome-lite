# Fichiers globaux du projet
# Les .gitignore spécifiques sont dans chaque sous-dossier

# Secrets et environnement (ne jamais versionner)
.env
.env.*
!.env.example
*.pem
*.p12

# IDE / Éditeurs (globaux)
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Système d'exploitation
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Sauvegardes BDD (scripts db/backup.sh)
db/backups/

# Fichiers temporaires globaux
*.tmp
*.temp
*.bak
*.orig
*.rej
.tmp/
.temp/
tmp/

# Docker (si utilisé à la racine)
docker-compose.override.yml
*.pid
*.seed
*.pid.lock

# Documentation builds
docs/_build/
site/

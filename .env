# ----- Backend : Base de données -----------------------------------------------
DATABASE_URL=postgresql://postgres:smarthome2025@10.109.150.75:5432/smarthome
DATABASE_HOST=10.109.150.75
DATABASE_PORT=5432
DATABASE_NAME=smarthome
DATABASE_USER=postgres
DATABASE_PASSWORD=smarthome2025
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ----- Backend : JWT -----------------------------------------------------------
SECRET_KEY=votre-cle-secrete-minimum-32-caracteres-changez-en-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- Backend : Serveur (bind FastAPI) ----------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
ENVIRONMENT=development

# ----- Backend : CORS ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000,http://localhost:8971
CORS_ALLOW_CREDENTIALS=true

# ----- Backend → RPi : appels du backend vers l'API Flask du RPi -----------------
RASPBERRY_PI_PROTOCOL=http
RASPBERRY_PI_PORT=5000
RASPBERRY_PI_API_KEY=smarthome2025
RASPBERRY_PI_TIMEOUT=5
RASPBERRY_PI_HEARTBEAT_INTERVAL=15
RASPBERRY_PI_OFFLINE_THRESHOLD=180

# ----- RPi : API Flask Z-Wave (écoute sur le RPi) -------------------------------
ZWAVE_JS_UI_URL=http://10.109.150.133:8091
ZWAVE_API_HOST=0.0.0.0
ZWAVE_API_PORT=5000
ZWAVE_DEBUG=true

# ----- RPi → Backend : heartbeat (RPi s'annonce en ligne) -----------------------
BACKEND_URL=http://10.109.150.75:8000
# Clé envoyée au backend (X-API-Key). Même valeur que RASPBERRY_PI_API_KEY côté backend.
RASPBERRY_API_KEY=smarthome2025

# ----- RPi : Détection présence Bluetooth (bt_presence_scan.py) ------------------
BT_PRESENCE_MODE=callback
BT_PRESENCE_SCAN_INTERVAL=45
BT_PRESENCE_SCAN_TIMEOUT=10
BT_PRESENCE_RSSI_MIN=-85
BT_PRESENCE_DEBOUNCE_SEC=30
BT_PRESENCE_KNOWN_MACS_REFRESH_SEC=300
PRESENCE_ONLY_KNOWN_MACS=0

# ----- Backend : ML / Smart dimming / Logs -------------------------------------
ML_MODEL_PATH=ml/models/scenario_classifier.pkl
ML_RETRAIN_THRESHOLD=100
SMART_DIMMING_ENABLED=true
SMART_DIMMING_THRESHOLD=10
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

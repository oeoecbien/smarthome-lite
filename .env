# Utilise BACKEND_URL (ci-dessus) pour l’URL de l’API.
API_USER=jean
API_PASS=Password123

# ----- Backend : ML / Smart dimming / Logs -------------------------------------
ML_MODEL_PATH=ml/models/scenario_classifier.pkl
ML_RETRAIN_THRESHOLD=100
OLLAMA_BASE_URL=
OLLAMA_MODEL=

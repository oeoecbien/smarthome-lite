[Unit]
Description=SmartHome Raspberry Pi Gateway Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smarthome/raspberrypi
Environment="PATH=/home/pi/smarthome/raspberrypi/venv/bin"
ExecStart=/home/pi/smarthome/raspberrypi/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

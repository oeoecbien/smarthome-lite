# Copier vers .env à la racine du dépôt (sae_s5/.env) et renseigner vos valeurs réelles.
# Le fichier .env ne doit jamais être commité.

# --- Base de données (backend) ---
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/smarthome
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=smarthome
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGEME
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=3600

# --- JWT / API (backend) ---
SECRET_KEY=remplacer-par-une-cle-secrete-d-au-moins-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
ENVIRONMENT=development

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# --- Backend → Raspberry Pi ---
RASPBERRY_PI_PROTOCOL=http
RASPBERRY_PI_PORT=5000
RASPBERRY_PI_API_KEY=
RASPBERRY_PI_TIMEOUT=5
RASPBERRY_PI_HEARTBEAT_INTERVAL=15
RASPBERRY_PI_OFFLINE_THRESHOLD=180

# --- Raspberry Pi / Z-Wave (lus par raspberry/) ---
ZWAVE_JS_UI_URL=http://localhost:8091
ZWAVE_API_HOST=0.0.0.0
ZWAVE_API_PORT=5000
ZWAVE_DEBUG=true

BACKEND_URL=http://localhost:8000
RASPBERRY_API_KEY=
# Node Z-Wave du capteur de mouvement (0 = désactivé)
MULTISENSOR7_NODE_ID=0

# Optionnel : scripts / tests manuels uniquement (ne pas utiliser en prod)
# API_USER=
# API_PASS=

# --- ML / Ollama (backend) ---
ML_MODEL_PATH=ml/models/scenario_classifier.pkl
ML_RETRAIN_THRESHOLD=100
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT=30

# --- Smart dimming ---
SMART_DIMMING_ENABLED=true
SMART_DIMMING_THRESHOLD=10

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
